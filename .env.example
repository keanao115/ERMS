# ==========================================
# ERMS Enterprise Environment Configuration
# ==========================================

# Database & Cache Connection
DATABASE_URL="postgresql://user:password@localhost:5433/erms_production?schema=public"
REDIS_HOST="localhost"
REDIS_PORT=6379

# Server Configuration
PORT=4000
NODE_ENV="development"

# JWT Authentication
JWT_SECRET="your_production_jwt_secret_key_change_me"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your_production_refresh_jwt_secret_key"
JWT_REFRESH_EXPIRES_IN="7d"

# ------------------------------------------
# Payment Gateways & Integration Adapters
# ------------------------------------------
# Stripe Payment Gateway (Leave empty if unconfigured)
STRIPE_API_KEY=""

# QuickBooks ERP Accounting Sync (Leave empty if unconfigured)
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""
QUICKBOOKS_ACCESS_TOKEN=""
QUICKBOOKS_REALM_ID=""

# Uber Eats Delivery Direct Webhooks (Leave empty if unconfigured)
UBER_EATS_WEBHOOK_SECRET=""
